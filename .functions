# Create a new directory and enter it
function md() {
  mkdir -p "$@" && cd "${@: -1}"
}


# find shorthand
function f() {
    find . -name "$1"
}

# cd into whatever is the forefront Finder window.
cdf() {  # short for cdfinder
  cd "`osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)'`"
}


# Start an HTTP server from a directory, optionally specifying the port
function server() {
  local port="${1:-8000}"
  open "http://localhost:${port}/"
  # Set the default Content-Type to `text/plain` instead of `application/octet-stream`
  # And serve everything as UTF-8 (although not technically correct, this doesn’t break anything for binary files)
  python3 -c $'import sys\nfrom http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer\nclass Handler(SimpleHTTPRequestHandler):\n\tdef guess_type(self, path):\n\t\ttype = super().guess_type(path)\n\t\tif type == "application/octet-stream":\n\t\t\ttype = "text/plain"\n\t\treturn type + ";charset=UTF-8"\nThreadingHTTPServer(("", int(sys.argv[1])), Handler).serve_forever()' "$port"
}

# git log with per-commit cmd-clickable GitHub URLs (iTerm)
function gf() {
  local remote="$(git remote -v | awk '/^origin.*\(push\)$/ {print $2}')"
  [[ "$remote" ]] || return
  local user_repo="$(echo "$remote" | perl -pe 's/.*://;s/\.git$//')"
  git log "$@" --name-status --color | awk "$(cat <<AWK
    /^.*commit [0-9a-f]{40}/ {sha=substr(\$2,1,7)}
    /^[MA]\t/ {printf "%s\thttps://github.com/$user_repo/blob/%s/%s\n", \$1, sha, \$2; next}
    /.*/ {print \$0}
AWK
  )" | less -F
}


# Copy w/ progress
cp_p () {
  rsync -WavP --human-readable --progress "$1" "$2"
}


# Test if HTTP compression is enabled for a given URL.
# Send a fake UA string for sites that sniff it instead of using the Accept-Encoding header. (Looking at you, ajax.googleapis.com!)
function httpcompression() {
  encoding="$(curl -LIs -H 'User-Agent: Mozilla/5 Gecko' -H 'Accept-Encoding: gzip, deflate, br, zstd' "$1" | grep -i '^Content-Encoding:')" && echo "$1 is encoded using ${encoding#* }" || echo "$1 is not using any encoding"
}

# Syntax-highlight JSON strings or files
function json() {
  if [ -p /dev/stdin ]; then
    # piping, e.g. `echo '{"foo":42}' | json`
    python3 -m json.tool | bat -l json -p
  else
    # e.g. `json '{"foo":42}'`
    python3 -m json.tool <<< "$*" | bat -l json -p
  fi
}


# take this repo and copy it to somewhere else minus the .git stuff.
function gitexport(){
  mkdir -p "$1"
  git archive HEAD | tar -x -C "$1"
}

# remove all the merged branches except the current one and master, main, develop & dev
function gitclean() {
  git branch --format='%(refname:short)' --merged \
    | grep -vxE "master|main|develop|developer|dev|$(git branch --show-current)" \
    | xargs git branch -d
}

# get gzipped size
function gz() {
  echo "orig size    (bytes): "
  wc -c < "$1"
  echo "gzipped size (bytes): "
  gzip -c "$1" | wc -c
}

# All the dig info (most servers refuse `ANY` queries, so ask for each type)
function digga() {
  local type
  for type in A AAAA CNAME MX NS TXT SOA; do
    dig +nocmd "$1" "$type" +multiline +noall +answer
  done
}

# Escape UTF-8 characters into their 3-byte format
function escape() {
  printf '%s' "$*" | xxd -p -c1 -u | sed 's/^/\\x/' | tr -d '\n'
  echo # newline
}

# Decode \x{ABCD}-style Unicode escape sequences
function unidecode() {
  printf '%s' "$*" | perl -CO -pe 's/\\x\{([0-9A-Fa-f]+)\}/chr(hex($1))/ge'
  echo # newline
}

# Extract archives - use: extract <file>
# Credits to http://dotfiles.org/~pseup/.bashrc
function extract() {
  if [ -f "$1" ] ; then
    case "$1" in
      *.tar.bz2) tar xjf "$1" ;;
      *.tar.gz) tar xzf "$1" ;;
      *.tar.xz) tar xJf "$1" ;;
      *.bz2) bunzip2 "$1" ;;
      *.rar) 7zz x "$1" ;;
      *.gz) gunzip "$1" ;;
      *.xz) unxz "$1" ;;
      *.tar) tar xf "$1" ;;
      *.tbz2) tar xjf "$1" ;;
      *.tgz) tar xzf "$1" ;;
      *.txz) tar xJf "$1" ;;
      *.zip) unzip "$1" ;;
      *.Z) uncompress "$1" ;;
      *.7z) 7zz x "$1" ;;
      *) echo "'$1' cannot be extracted via extract()" ;;
    esac
  else
    echo "'$1' is not a valid file"
  fi
}

# animated gifs from any video
gifify() {
  if [[ -n "$1" ]]; then
    local tmpdir="$(mktemp -d)"
    local palette="$tmpdir/palette.png"
    local filters="fps=10,scale=360:-1:flags=lanczos"
    local dir=$(dirname -- "$1")
    local file=$(basename -- "$1")
    local filename=${file%%.*}
    ffmpeg -v warning -i "$1" -vf "$filters,palettegen" -update 1 -y "$palette"
    ffmpeg -v warning -i "$1" -i "$palette" -lavfi "$filters [x]; [x][1:v] paletteuse" -y "$dir/$filename.gif"
    rm -rf "$tmpdir"
  else
    echo "proper usage: gifify <input_movie.mov>. You Do need to include extension."
  fi
}

# display the remaining battery health (current max capacity vs. design capacity)
batterylife() {
  ioreg -rn AppleSmartBattery | awk '/"AppleRawMaxCapacity" =/ {max=$3} /"DesignCapacity" =/ {design=$3} END {printf "%.1f%%\n", max / design * 100}'
}

# Open man page as PDF
function manpdf() {
  mandoc -T pdf "$(man -w "${1}")" | open -f -a Preview
}

# colorize Java code snippet copied from the Clipboard and copy the colorized version
function java-highlight {
  pbpaste | highlight --syntax=java -O rtf | pbcopy
}

# list all local git branches which are squash-merged into the base branch (default: upstream/develop)
function list-squash-merged-branches() {
  local base="${1:-upstream/develop}" branch mergeBase
  git for-each-ref refs/heads/ "--format=%(refname:short)" | \
    while read -r branch; do
      mergeBase=$(git merge-base "$base" "$branch") \
        && \
        [[ $(git cherry "$base" "$(git commit-tree "$(git rev-parse "$branch^{tree}")" -p "$mergeBase" -m _)") == "-"* ]] \
        && \
        echo "$branch"
    done
}


# delete all local git branches which are squash-merged into the base branch (default: upstream/develop)
function delete-squash-merged-branches() {
  list-squash-merged-branches "$@" \
    | grep -vxF "$(git branch --show-current)" \
    | xargs git branch -D
}

# quick set the JAVA_HOME environment variable
function javahome() {
  export JAVA_HOME=$(/usr/libexec/java_home -v "$1");
  java -version
}
