# Put Homebrew (Apple Silicon) ahead of the system binaries
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# Prefer US English and use UTF-8
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Make vim the default editor
export EDITOR="vim"
# Don’t clear the screen after quitting a manual page
export MANPAGER="less -X"

# Larger zsh history (allow 32³ entries; macOS default is 2000 in memory, 1000 on disk)
export HISTFILE=~/.zsh_history
export HISTSIZE=32768
export SAVEHIST=$HISTSIZE
setopt HIST_IGNORE_DUPS     # don't record a command that duplicates the previous one
setopt EXTENDED_HISTORY     # save timestamps and durations for later analysis
setopt INC_APPEND_HISTORY   # write commands to the history file as they're run

# Make some commands not show up in the history file
export HISTORY_IGNORE="(ls|ls *|cd|cd -|pwd|exit|date|* --help)"

# Android-related environment settings
export ANDROID_HOME=${HOME}/Library/Android/sdk
if [ -d "$ANDROID_HOME" ]; then
  export PATH=${PATH}:${ANDROID_HOME}/platform-tools
  export PATH=${PATH}:${ANDROID_HOME}/emulator
fi

# For nvm
export NVM_DIR=~/.nvm
if [ -n "$HOMEBREW_PREFIX" ] && [ -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ]; then
  source "$HOMEBREW_PREFIX/opt/nvm/nvm.sh"
fi
